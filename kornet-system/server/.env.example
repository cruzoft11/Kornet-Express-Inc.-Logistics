# Kornet Express backend environment example
PORT=4000
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=2mb
DATABASE_URL="file:./data/kornet.db"
ACCOUNTING_DB_PATH=prisma/data/accounting.db
JWT_ACCESS_SECRET=replace-with-random-32-byte-minimum-secret
JWT_REFRESH_SECRET=replace-with-different-random-32-byte-minimum-secret
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-before-seeding

# Optional live tracking feeds. Review provider terms before enabling vessel AIS.
OPENSEAFEED_ENABLED=false
OPENSEAFEED_TERMS_APPROVED=false
OPENSEAFEED_API_KEY=

# Customer addresses are sent to Geoapify only after an authorized user requests a preview.
# Set the approval flag only after reviewing privacy, data-processing, and commercial terms.
GEOAPIFY_TERMS_APPROVED=false
GEOAPIFY_API_KEY=
