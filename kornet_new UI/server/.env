# Kornet Express Logistics — backend environment
# Copy to .env (already provided) and adjust as needed.

# HTTP port the API listens on (Vite proxies /api here)
PORT=4001

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# SQLite database location (file-based, zero external services)
DATABASE_URL="file:./data/kornet.db"

# JWT secrets — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=kornet-dev-access-secret-change-me
JWT_REFRESH_SECRET=kornet-dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# Seed admin credentials (created by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=kornet2000
